objSet objclass "building"
objSet description "Fire Shrine"
objSet race "beast"
objSet model "/models/beast/buildings/fire.model"
objSet icon "/models/beast/buildings/icons/fire"
objSet tooltip "Attracts and retains the energy of fire.  This shrine is necessary for the research and production of all Fire magic."
objSet selectionSound "/sound/beast/buildings/fire_shrine.wav"
objSet gridmenu "/gridmenus/layout_default.cfg"
objSet proximitySound "default"
objSet builder1 "beast_worker"
objSet requirement1 "beast_nexus"
objSet needBasePoints 1
objSet techPointValue 1
objSet techType "fire"
objSet cost stone 800
objSet researchTime 100000
objSet fullHealth 15000
objSet radiusState "state0"
objSet backbone "bip01 spine2"
objSet mineType "stone"
objSet generate -NULL -stone -gold -electric -magnetic -chemical +fire -strata -entropy 
objSet store fire 100
objSet healthStage1 75
objSet healthStage3 25
objSet healthStage1Effect "fire_medium"
objSet healthStage2Effect "fire_medium"
objSet healthStage3Effect "fire_medium"
objSet healthStage1Period 200 200
objSet healthStage2Period 90 90
objSet healthStage3Period 50 50
objSet forcedRadiusState "state0"
objSet insideState "state0"
objSet deathEffect "large_explosion"
objSet constructionSound "/sound/general/construction.wav"
