objSet objclass "building"
objSet description "Electrical Factorium"
objSet race "human"
objSet model "/models/human/buildings/electric.model"
objSet icon "/models/human/buildings/icons/electric"
objSet selectionIcon "/models/human/buildings/icons/electric.tga"
objSet tooltip "Stores and produces electricity.  This strucutre is required for the production and research of all things electric."
objSet selectionSound "/sound/human/buildings/electrical_factorium.wav"
objSet gridmenu "/gridmenus/layout_default.cfg"
objSet proximitySound "default"
objSet builder1 "human_worker"
objSet requirement1 "human_arsenal"
objSet needBasePoints 1
objSet techPointValue 1
objSet techType "electric"
objSet cost stone 800
objSet researchTime 100000
objSet viewHeight 25.000000
objSet fullHealth 15000
objSet radiusState "state0"
objSet backbone "bip01 spine2"
objSet mineType "stone"
objSet generate -NULL -stone -gold +electric -magnetic -chemical -fire -strata -entropy 
objSet store electric 100
objSet healthStage1 75
objSet healthStage3 25
objSet healthStage1Effect "fire_small"
objSet healthStage2Effect "fire_small"
objSet healthStage3Effect "fire_small"
objSet healthStage1Period 200 200
objSet healthStage2Period 90 90
objSet healthStage3Period 50 50
objSet forcedRadiusState "state0"
objSet insideState "state0"
objSet deathEffect "small_explosion"
objSet constructionSound "/sound/general/construction.wav"
