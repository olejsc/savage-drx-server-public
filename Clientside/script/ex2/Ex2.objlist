//////////////////////////////////
// Ex2 Human Modifications

// Units
objEdit human_ballista
objSet viewHeight 40.000000
objSet distOffset 80
objSet minAimX 0.300000
objSet maxAimX 0.700000
objSet minAimY 0.250000
objSet maxAimY 0.650000

objEdit human_catapult
objSet unitpierce 1.000000
objSet killGoldReward 1000

objEdit catapult_weapon
objSet unitpierce 1.000000

objEdit human_medic
objSet playerCost 2500
objSet killGoldReward 3000
objSet mineRate 5
objSet repairRate 25
objSet manaRegenRate 100
objSet fullHealth 250

objEdit human_medic_melee
objSet damage 80

objEdit human_potion
objSet ammoMax 10
objSet ammoStart 10

objEdit human_nomad
objSet killGoldReward 3000

objEdit human_worker
objSet maxCarry gold 40

// Weapons
objEdit human_crossbow
objSet ammoMax 18
objSet ammoStart 18
objSet playerCost 0

objEdit human_discharger
objSet velocity 500.000000 500.000000

objEdit human_incinerator
objSet damage 5
objSet radius 0.000000 0.000000
objSet projectileRadius 7.000000
objSet velocity 300.000000 300.000000
objSet maxVelocity 1000.000000
objSet accelerate -300.000000
objSet heatFlags +velocity -damage +range -accuracy -fusetime -blastradius -blastdamage -count -inverse 
objSet refreshTime 50
objSet fuseTime 800 800
objSet bounce 0.600000
objSet hitWorld "bounce"
objSet unitpierce 1.000000
objSet bldpierce 0.750000
objSet siegepierce 1.000000

objEdit human_launcher
objSet refreshTime 1500
objSet ammoMax 10
objSet ammoStart 10
objSet ammoGroup 1
objSet ammoCost 400
objSet unitpierce 0.750000
objSet bldpierce 1.400000
objSet siegepierce 1.000000

objEdit human_mortar
objSet velocity 500.000000 500.000000
objSet refreshTime 900
objSet ammoMax 8
objSet ammoStart 8

objEdit human_repeater
objSet ammoMax 100
objSet ammoStart 100

objEdit human_scattergun
objSet accuracy 0.100000
objSet ammoMax 10
objSet ammoStart 10

objEdit human_sniperbow
objSet damage 300
objSet siegepierce 0.500000

// Items
objEdit human_disruptor
objSet damage 350
objSet radius 100.000000 100.000000

objEdit human_heal
objSet velocity 500.000000 500.000000

objEdit human_imobilizer
objSet hitWorld "bounce"

objEdit human_motion_sensor
objSet maxDeployment 12

// Buildings
objEdit arrow_tower_weapon
objSet velocity 1500.000000 1500.000000

objEdit chem_tower_weapon
objSet count 5 5
objSet damage 100
objSet radius 50.000000 50.000000
objSet unitpierce 1.000000

objEdit human_electric_tower
objSet refreshTime 600
objSet fullHealth 4000
objSet weapon "elec_tower_weapon"
objSet targetProjectiles 1
objSet shiftProjAccel 0.000000

objEdit human_monastery
objSet cost stone 800


