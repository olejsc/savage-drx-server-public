//friendly buildings alerts (enemy attacking our building)
//
//these are in the form "friend_race_objectname_warningtype"
//
//where "race" is the race of the announcer saying the message
//
//valid warningtypes:
//
//under_attack
//half_destroyed
//nearly_destroyed
//destroyed
//destroyed_all    - all buildings of this type are destroyed
//low        - mine low
//under_siege    - building being attacked by a siege weapon

friend_human_human_stronghold_half_destroyed    	sound/samurai/commander/081ourcommandcentreisburning:2
friend_human_human_stronghold_half_destroyed_text  	Our Command Centre is burning!
friend_human_human_stronghold_under_attack      	sound/samurai/commander/083ourcommandcentrehadbeendamaged:2
friend_human_human_stronghold_under_attack_text    	Our Command Centre has been damaged!
friend_human_human_stronghold_nearly_destroyed    	sound/samurai/commander/085ourcommandcentreisnearlydestroyed:2
friend_human_human_stronghold_nearly_destroyed_text Our Command Centre is nearly destroyed!
friend_human_human_stronghold_under_siege      		sound/samurai/commander/087ourcommandcentreisundersiege:2
friend_human_human_stronghold_under_siege_text    	Our Command Centre is under siege!
friend_human_human_garrison_under_attack      		sound/samurai/commander/025ourbarracksareunderattack:1
friend_human_human_garrison_under_attack_text    	Our Barracks are under attack!
friend_human_human_garrison_destroyed        		sound/samurai/commander/026ourbarrackshavebeendestroyed:2
friend_human_human_garrison_destroyed_text      	Our Barracks have been destroyed!
friend_human_human_siege_destroyed_all        		sound/samurai/commander/077ourseigeunitshavebeendisabled:1
friend_human_human_siege_destroyed_all_text      	Our SIEGE units have been disabled!

//generic ones:
enemy_human_building_destroyed      	sound/samurai/units/140wehavedestroyedtheenemystructure:1
enemy_human_building_destroyed_text    	We have destroyed an enemy structure
friend_human_building_destroyed      	sound/samurai/units/139theyhavedestroyedabuilding:1
friend_human_building_destroyed_text  	They have destroyed a building!



