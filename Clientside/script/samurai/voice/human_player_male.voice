//voice chats are specified first by issuing a category name, then listing individual items

//syntax:
//voiceCategory <Number> <Description>
//voiceItem <Number> <Description>
//voiceSound <WavFile> <ChatText>
//voiceMore <Number> <Description> <CategoryNumber>
//voiceFlag <team | global>

//voiceSound may be specified up to 4 times for the same item (for multiple versions of the same voice chat)
//voiceItem can be specified up to 10 times per voiceCategory
//voiceMore allows sub menus to be specified
//voiceFlag specifies team or global chat


voiceDirectory /sound/samurai/units/  //base directory to look for WAV files (specify once per file)


voiceCategory 0


//
// Observation
//

voiceCategory 1

voiceItem 1 "Ronin spotted" 
voiceSound 132thereareroninoverthere_1.ogg "Ronin spotted"
voiceFlag team

voiceItem 2 "Resources spotted"
voiceSound 190resourcesspotted_1.ogg "Resources spotted"
voiceFlag team

voiceItem 3 "Enemy spotted"
voiceSound 142enemyspotted_1.ogg "Enemy spotted"
voiceFlag team

voiceItem 4 "Enemy marksman spotted"
voiceSound 162enemymarksmanspotted_1.ogg "Enemy Marksman spotted"
voiceFlag team

voiceItem 5 "They have constructed a Barracks!" 
voiceSound 129theyhaveconstructedabarracks_1.ogg "They have constructed a Barracks!"
voiceFlag team

voiceItem 6 "Enemy cannon spotted"
voiceSound 193enemycannonspotted_1.ogg "Enemy Cannon spotted"
voiceFlag team

voiceItem 7 "All clear"
voiceSound 108allclear_1.ogg "All clear"
voiceFlag team



//
// Basic
//

voiceCategory 2

voiceItem 1 "Your orders?"
voiceSound 106yourorders_1.ogg "Your orders?"


voiceItem 2 "Yes!"
voiceSound 204yes_3.ogg "Yes!"
voiceSound 192rightaway_1.ogg "Right away!"
voiceSound 107absolutely_1.ogg "Absolutely!"
voiceSound 128commandunderstood_1.ogg "command understood"


voiceItem 3 "No!"
voiceSound 183no_1.ogg "No!"
voiceSound 156impossible_1.ogg "Impossible!"


voiceItem 4 "Hello!"
voiceSound 149hello_1.ogg "Hello"


voiceItem 5 "Thank you"
voiceSound 197arigato_1.ogg "Thank you"
voiceSound 197arigato_2.ogg "Thank you"


voiceItem 6 "Help!!!"
voiceSound 151help_1.ogg "Help!!!"



voiceItem 7 "For the clan"
voiceSound 144fortheclan_1.ogg "For the clan!"
voiceSound 161buddhabepraised_1.ogg "Buddha be praised!"

voiceItem 8 "I need healing!"
voiceSound 173ineedhealing_1.ogg "I need healing!"
voiceSound 174pleasehealme_1.ogg "Please heal me!"

voiceItem 9 "I need a blessing!"
voiceSound 172ineedablessing_1.ogg "I need a blessing!"
voiceFlag team




