//voice chat config for human commander

//voice chats are specified first by issuing a category name, then listing individual items

//syntax:
//voiceCategory <Number> <Description>
//voiceItem <Number> <Description>
//voiceSound <WavFile> <ChatText>
//voiceMore <Number> <Description> <CategoryNumber>
//voiceFlag <team | global>

//voiceSound may be specified up to 4 times for the same item (for multiple versions of the same voice chat)
//voiceItem can be specified up to 10 times per voiceCategory
//voiceMore allows sub menus to be specified
//voiceFlag specifies team or global chat

voiceCommander human		//specifies that this is the commander voice chat menu belonging to the human race

voiceDirectory sound/samurai/commander	//base directory to look for WAV files (specify once per file)

//
// GENERAL ORDERS
//

voiceCategory 1

voiceItem 1 "Destroy the enemy Command Centre"
voiceSound 016destroytheenemycommandcentre_1.ogg "Destroy the enemy Command Centre"
voiceSound 016destroytheenemycommandcentre_2.ogg "Destroy the enemy Command Centre"
voiceSound 016destroytheenemycommandcentre_3.ogg "Destroy the enemy Command Centre"
voiceSound 016destroytheenemycommandcentre_4.ogg "Destroy the enemy Command Centre"

voiceItem 2 "Capture the spawn flag"
voiceSound 010capturethespawnflag_1.ogg "Capture the Spawn Flag"

voiceItem 3 "Return to base"
voiceSound 070returntobase_1.ogg "Return to base"
voiceSound 070returntobase_2.ogg "Return to base"

voiceItem 4 "Scout for resources" 
voiceSound 074scoutforrecources_1.ogg "Scout for resources"
voiceSound 074scoutforrecources_2.ogg "Scout for resources"
voiceSound 074scoutforrecources_3.ogg "Scout for resources"

voiceItem 5 "Scout for enemies" 
voiceSound 072scoutforenemies_1.ogg "Scout for enemies"
voiceSound 072scoutforenemies_2.ogg "Scout for enemies"

voiceItem 6 "We need more gold"
voiceSound 050weneedmoregold_1.ogg "We need more Gold"
voiceSound 050weneedmoregold_2.ogg "We need more Gold"

voiceItem 7 "We need more stone"
voiceSound 054weneedmorestone_1.ogg "We need more Stone"
voiceSound 054weneedmorestone_2.ogg "We need more Stone"


//
// MISC COMMUNICATION
//

voiceCategory 2

voiceItem 1 "Thank you"
voiceSound 089thankyou_1.ogg "Thank you"
voiceSound 089thankyou_2.ogg "Thank you"

voiceItem 2 "Reminder"
voiceSound 028igaveyouacommand_1.ogg "I gave you a command"
voiceSound 028igaveyouacommand_2.ogg "I gave you a command"
voiceSound 058obeymyorder_1.ogg "Obey my order"
voiceSound 058obeymyorder_2.ogg "Obey my order"
voiceSound 048youmustobeymyorder_1.ogg "You must obey my order"
voiceSound 048youmustobeymyorder_2.ogg "You must obey my order"
voiceSound 060notheotherway_1.ogg "No ... the other way"
voiceSound 060notheotherway_2.ogg "No ... the other way"
voiceSound 060notheotherway_3.ogg "No ... the other way"

voiceItem 3 "Cancel orders"
voiceSound 056nevermind_1.ogg "Nevermind"
voiceSound 056nevermind_2.ogg "Nevermind"
voicesound 021disregardthatorder_1.ogg "Disregard that order"
voicesound 021disregardthatorder_2.ogg "Disregard that order"

//
// MAIN
//

//each voice config must have a 0 category set in order to display the initial voice chat menu

voiceCategory 0

voiceMore 1 "General Orders" 1
voiceMore 2 "Misc Communication" 2
