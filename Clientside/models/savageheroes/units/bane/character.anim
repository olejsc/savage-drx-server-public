//syntax:

//makeanim AnimName ClipFile StartFrame NumFrames FPS Loop(0 or 1) Loopbackframe

//common

makeanim idle  clip/idle.clip 0 0 40 1
//makeanim push  clip/push.clip
//makeanim grab  clip/grab.clip
//makeanim throw clip/throw.clip

//melee combat

makeanim melee_1 clip/melee_1.clip 0 0 30
makeanim melee_2 clip/melee_2.clip 0 0 30
makeanim melee_3 clip/melee_3.clip 0 0 30
makeanim melee_4 clip/melee_2.clip 0 0 30

makeanim melee_move_1 clip/melee_move_1.clip 0 55 33
makeanim melee_move_2 clip/melee_move_2.clip 6 56 30
makeanim melee_move_3 clip/melee_move_3.clip 6 56 30
makeanim melee_move_4 clip/melee_move_2.clip 6 56 30

//general character animation

makeanim walk_left clip/run_lft.clip 0 0 20 1
makeanim walk_right clip/run_rgt.clip 0 0 20 1
makeanim walk_fwd clip/walk.clip 0 34 36 1
makeanim walk_back clip/run_bck.clip 0 0 36 1

makeanim run_left clip/run_lft.clip 0 0 30 1
makeanim run_right clip/run_rgt.clip 0 0 30 1
makeanim run_fwd clip/run_fwd.clip 0 20 30 1
makeanim run_back clip/run_bck.clip 0 0 40 1
                                                                                                           	
makeanim sprint_left clip/run_lft.clip 0 0 35 1
makeanim sprint_right clip/run_rgt.clip 0 0 35 1
makeanim sprint_fwd clip/sprint.clip  0 16 26 1
makeanim sprint_back clip/run_bck.clip 0 0 45 1


makeanim jump_start_left clip/jump.clip 0 1
makeanim jump_start_right clip/jump.clip 0 1
makeanim jump_start_fwd clip/jump.clip 0 1
makeanim jump_start_back clip/jump.clip 0 1

makeanim jump_mid_left clip/jump.clip 1 1
makeanim jump_mid_right clip/jump.clip 1 1
makeanim jump_mid_fwd clip/jump.clip 2 1
makeanim jump_mid_back clip/jump.clip 1 1
  
makeanim jump_end_left clip/jump.clip 3 1
makeanim jump_end_right clip/jump.clip 3 1
makeanim jump_end_fwd clip/jump.clip 3 1
makeanim jump_end_back clip/jump.clip 3 1
  
makeanim jump_up_start clip/jump.clip 0 1
makeanim jump_up_mid clip/jump.clip 1 1
makeanim jump_up_end clip/jump.clip 2 1
makeanim jump_land clip/jump.clip 3 1


makeanim dodge_start_left clip/jump.clip 0 1
makeanim dodge_start_right clip/jump.clip 0 1
makeanim dodge_start_fwd clip/dodge.clip 0 1
makeanim dodge_start_back clip/jump.clip 0 1

makeanim dodge_mid_left clip/jump.clip 1 1
makeanim dodge_mid_right clip/jump.clip 1 1
makeanim dodge_mid_fwd clip/dodge.clip 1 1
makeanim dodge_mid_back clip/jump.clip 1 1
  
makeanim dodge_end_left clip/jump.clip 2 1
makeanim dodge_end_right clip/jump.clip 2 1
makeanim dodge_end_fwd clip/dodge.clip 2 1
makeanim dodge_end_back clip/jump.clip 2 1



makeanim wounded_left clip/wounded.clip 0 0 40
makeanim wounded_right clip/wounded.clip 0 0 40
makeanim wounded_fwd clip/wounded.clip 0 0 40
makeanim wounded_back clip/wounded.clip 0 0 40

makeanim death_generic clip/death.clip 0 0 60
makeanim resurrected clip/revive.clip 0 0 27


//player holding weapon animations

makeanim weapon_charge_1 clip/spin.clip 0 0 45
makeanim weapon_charge_2 clip/bash.clip 0 0 40
makeanim weapon_charge_3 clip/howl.clip
makeanim weapon_charge_4 clip/channeling.clip

makeanim weapon_fire_1 clip/spin.clip 0 0 45
makeanim weapon_fire_2 clip/bash.clip 0 0 40
makeanim weapon_fire_3 clip/howl.clip
makeanim weapon_fire_4 clip/channeling.clip 
makeanim weapon_fire_5 clip/drop.clip 

makeanim weapon_reload_1 clip/weapon_reload_1.clip
makeanim weapon_reload_2 clip/weapon_reload_2.clip
makeanim weapon_reload_3 clip/weapon_reload_3.clip
makeanim weapon_reload_4 clip/weapon_reload_4.clip

// Sound Events

animevent death_generic 0 "sound /models/savageheroes/units/bane/sound/death.wav" 

animevent weapon_fire_2 38 "effect behemoth_footstep Bip01 L Foot" 
animevent weapon_fire_2 42 "effect behemoth_footstep Bip01 R Foot" 

animevent weapon_fire_1 0 "sound /models/savageheroes/units/bane/sound/spin.wav" 
animevent weapon_fire_2 5 "sound /models/savageheroes/units/bane/sound/bash.wav" 
animevent weapon_fire_3 0 "sound /models/savageheroes/units/bane/sound/howl.wav" 

animevent grab  0  "randsound 4 /sound/physics/grab_throw"
animevent throw 0  "randsound 4 /sound/physics/grab_throw"
animevent push  0  "sound /models/savageheroes/units/bane/sound/growl.wav"

animevent run_left 10 "footstepleft"
animevent run_left 15 "footstepright"

animevent run_right 9 "footstepleft"
animevent run_right 22 "footstepright"

animevent run_fwd 8 "footstepleft"
animevent run_fwd 22 "footstepright"

Danimevent run_back 8 "footstepleft"
animevent run_back 16 "footstepright"

animevent walk_back 8 "footstepleft"
animevent walk_back 16 "footstepright"

animevent sprint_fwd 1 "footstepleft"
animevent sprint_fwd 10 "footstepright"

animevent melee_1 1 "sound /models/savageheroes/units/bane/sound/melee_1.wav"
animevent melee_2 0 "sound /models/savageheroes/units/bane/sound/melee_3.wav"
animevent melee_3 0 "sound /models/savageheroes/units/bane/sound/melee_2.wav"
animevent melee_4 0 "sound /models/savageheroes/units/bane/sound/melee_0.wav"

animevent melee_move_1 1 "sound /models/savageheroes/units/bane/sound/melee_1.wav"
animevent melee_move_2 0 "sound /models/savageheroes/units/bane/sound/melee_3.wav"
animevent melee_move_3 0 "sound /models/savageheroes/units/bane/sound/melee_2.wav"
animevent melee_move_4 0 "sound /models/savageheroes/units/bane/sound/melee_0.wav"

animevent wounded_left 0 "randsound 5 /sound/general/impact/melee/flesh"
animevent wounded_right 0 "randsound 5 /sound/general/impact/melee/flesh"
animevent wounded_fwd 0 "randsound 5 /sound/general/impact/melee/flesh"
animevent wounded_back 0 "randsound 5 /sound/general/impact/melee/flesh"

//animevent wounded_left 1 "randsound 3 /sound/human/units/legionnaire/grunt"
//animevent wounded_right 1 "randsound 3 /sound/human/units/legionnaire/grunt"
//animevent wounded_fwd 1 "randsound 3 /sound/human/units/legionnaire/grunt"
//animevent wounded_back 1 "randsound 3 /sound/human/units/legionnaire/grunt"
