//Particles:
vfEdit 0
vfSet visclass "particles"
vfSet flags -parent_pos -parent_vel -param_location -param_scale -param_count
vfSet shader "textures/effects/stars/1_nl_star0000.tga"
vfSet size 2.000000 10.000000
vfSet growth 0.000000 0.000000
vfSet alpha 1.000000 1.000000
vfSet fade 0.000000 0.000000
vfSet white 1.000000 1.000000
vfSet whitefade 0.000000 0.000000
vfSet red 0.700000 1.000000
vfSet green .700000 0.700000
vfSet blue 0.000000 0.000000
vfSet redfade -1.000000 -1.000000
vfSet greenfade -1.000000 -1.000000
vfSet bluefade -1.000000 -1.000000
vfSet delay 0 50
vfSet lifetime 400 500
vfSet tilelength 0.000000
vfSet style "point"
vfSet model ""
vfSet skin ""
vfSet count 5 10
vfSet velocity 25.000000 30.000000
vfSet MulVelX 1.000000
vfSet MulVelY 1.00000
vfSet MulVelZ 0.00000
vfSet acceleration 0.000000 0.000000
vfSet fps 0 0
vfSet offset 5.000000 10.000000
vfSet forcedOffsetX 0.000000
vfSet forcedOffsetY 0.000000
vfSet forcedOffsetZ 50.000000
vfSet gravity 1.000000 1.500000
vfSet angle 180.000000 180.000000
vfSet spin 0.000000 0.000000
vfSet bone ""

