//Particles:
vfEdit 0
vfSet visclass "particles"
vfSet flags +parent_pos -parent_vel -param_location -param_scale -param_count -param_groundz -param_sinewave -param_nearparent -param_billboard2d -param_terrainz -grow_shrink_linear -grow_shrink_poly -alloc_trail -alloc_trail_per_child -trail_rendering -terrain_decal -children_use_own_trail -terrain_col_decal -static_obj_col_decal -parent_pos_static 
vfSet shader "/textures/effects/explosions/fire/1_nl_fire.tga"
vfSet mod_shader ""
vfSet size 4.000000 6.000000
vfSet sizeHeight 0.000000 0.000000
vfSet growth 30.000000 40.000000
vfSet alpha 0.300000 0.9000000
vfSet fade -0.500000 -0.900000
vfSet white 1.000000 1.000000
vfSet whitefade -0.500000 -0.900000
vfSet red 0.800000 1.000000
vfSet green 0.800000 1.0000000
vfSet blue 0.400000 0.600000
//vfSet redfade -1.000000 -1.000000
//vfSet greenfade -1.000000 -1.000000
//vfSet bluefade -1.000000 -1.000000
vfSet redfade -0.4000000 -0.7000000
vfSet greenfade -0.4000000 -0.7000000
vfSet bluefade -0.4000000 -0.7000000
vfSet delay 0 0
vfSet lifetime 400
vfSet tilelength 0.000000
vfSet style "point"
vfSet model ""
vfSet skin ""
//vfSet count 50 80
vfSet count 150 
vfSet velocity 300.000000
vfSet MulVelX 1.000000
vfSet MulVelY 1.00000
vfSet MulVelZ 0.00000
vfSet acceleration 100.000000 100.000000
vfSet fps 0 0
vfSet offset 0.000000 0.000000
vfSet forcedOffsetX 0.000000
vfSet forcedOffsetY 0.000000
vfSet forcedOffsetZ 15.000000
vfSet gravity -0.500000 -1.000000
vfSet angle 0.000000 0.000000
vfSet spin -180.000000 180.000000
vfSet bone ""
vfSet alt_offset 0.000000 0.000000
vfSet max_range 0.000000
vfSet minZ -999999.000000
vfSet maxZ 999999.000000
vfSet dieshader ""
vfSet dieFPS 25 25
vfSet playUnderConstruction 0
vfSet spawnmode "none"
vfSet spawncollisionflags -terrain -static -dynamic -complex -gameobject -not_solid -foliage -ex0 -ex1 -ex2 -ex3 -solid_item -transparent_item -corpse -push_zone -revivable -ex4 -ex5 -ex6 -ex7 
vfSet spawndelay 0
vfSet spawnradius 0.000000 0.000000
vfSet spawnviseffect 0
vfSet spawncount 1 1
vfSet spawninterval 0 0
vfSet spawninheritlife 0.000000 0.000000
vfSet windcoeff 0.000000 0.000000
vfSet trailshaderpriority 0
vfSet fadetime 0.000000
vfSet max_ZDist 0

