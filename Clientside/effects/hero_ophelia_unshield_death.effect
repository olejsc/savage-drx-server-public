efSet sound1 "/sound/effects/pulse_explosion_1.wav"
efSet sound2 "/sound/effects/pulse_explosion_2.wav"
efSet sound3 "/sound/effects/pulse_explosion_3.wav"
efSet sound4 ""
efSet loopsound ""
efSet cmdrSound ""
efSet broadcastSound ""
efSet stopLoopSound 1
efSet soundVolume 1
efSet soundRadius 140
efSet cameraShake 0.000000 0.000000

//Particles:
vfEdit 0
vfSet visclass "particles"
vfSet flags -parent_pos -parent_vel -param_location -param_scale -param_count 
//vfSet shader "/textures/effects/explosions/1_nl_exp_blast_blue.tga"
vfSet shader "/models/savageheroes/units/ophelia/1_nl_ophelia_fglow0000.tga"
vfSet size 3.000000 5.000000
vfSet growth 10.000000 20.000000
vfSet alpha 1.000000 1.000000
vfSet fade 0.000000 0.000000
vfSet white 1.000000 1.000000
vfSet whitefade -1.000000 -1.000000
//vfSet red 0.200000 0.200000
//vfSet green 1.000000 1.000000
//vfSet blue 0.200000 0.200000
vfSet red 0.00000 0.000000
vfSet green 0.000000 0.0000000
vfSet blue 0.00000 0.00000
vfSet redfade 0.000000 0.000000
vfSet greenfade 0.000000 0.000000
vfSet bluefade 0.000000 0.000000
vfSet delay 0 0
vfSet lifetime 1000 1000
vfSet tilelength 0.000000
vfSet style "point"
vfSet model ""
vfSet skin ""
vfSet count 2 5
vfSet velocity 0.000000 0.1000000
vfSet acceleration 0.000000 0.000000
vfSet fps 0 0
vfSet offset 0.000000 10.000000
vfSet gravity 0.000000 0.000000
vfSet angle 0.000000 360.000000
vfSet spin 0.000000 0.000000
vfSet bone ""

