//Particles:
vfEdit 0
vfSet visclass "particles"
vfSet flags -parent_pos -parent_vel -param_location -param_scale -param_count -param_groundz -param_sinewave -param_nearparent +param_billboard2d 
vfSet shader "/textures/weather_effects/1_nl_rain.tga"
vfSet size 0.120000 0.150000
vfSet sizeHeight 5.000000 7.000000
vfSet growth 0.000000 0.000000
vfSet alpha 0.500000 0.700000
vfSet fade 1.000000 1.000000
vfSet white 1.000000 1.000000
vfSet whitefade 0.000000 0.000000
vfSet red 0.000000 0.000000
vfSet green 0.000000 0.000000
vfSet blue 0.000000 0.000000
vfSet redfade 0.000000 0.000000
vfSet greenfade 0.000000 0.000000
vfSet bluefade 0.000000 0.000000
vfSet delay 0 50
vfSet lifetime 800 1500
vfSet tilelength 0.000000
vfSet style "point"
vfSet model ""
vfSet skin ""
vfSet count 80 100
vfSet velocity 0.000000 0.000000
vfSet acceleration 0.000000 0.000000
vfSet fps 0 0
vfSet offset 5.000000 300.000000
vfSet gravity 4.000000 8.000000
vfSet angle 0.000000 0.000000
vfSet spin 0.000000 0.000000
vfSet bone ""
vfSet alt_offset 0.000000 0.000000
vfSet max_range 300.000000
vfSet minZ -140.000000
vfSet maxZ 9999999.000000

