//Particles:
vfEdit 0
vfSet visclass "particles"
vfSet flags +parent_pos -parent_vel -param_location -param_scale -param_count
vfSet shader "textures/effects/stars/1_nl_bluestar0000.tga"
vfSet size 2.000000 15.000000
vfSet growth -5.000000 32.000000
vfSet alpha 1.000000 1.000000
vfSet fade 0.000000 0.000000
vfSet white 1.000000 1.000000
vfSet whitefade 0.000000 0.000000
vfSet red 0.000000 0.000000
vfSet green 0.000000 0.000000
vfSet blue 0.000000 0.000000
vfSet redfade 0.000000 0.000000
vfSet greenfade 0.000000 0.000000
vfSet bluefade 0.000000 0.000000
vfSet delay 0 0
vfSet lifetime 2200 2700
vfSet tilelength 0.000000
vfSet style "point"
vfSet model ""
vfSet skin ""
vfSet count 150 180
vfSet velocity 85.000000 105.000000
vfSet MulVelX 1.000000
vfset MulVelY 0.800000
vfSet MulVelZ 0.050000
vfSet acceleration 75.000000 105.000000
vfSet fps 0 0
vfSet offset 15.000000 25.000000
vfSet gravity 0.40000 -0.100000
vfSet angle 0.000000 180.000000
vfSet spin 0.000000 180.000000
vfSet bone ""

