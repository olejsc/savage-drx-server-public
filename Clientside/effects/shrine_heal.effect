vfSet velocity 2.00000 3.00000
vfSet acceleration 0.000000 0.000000
vfSet fps 30 30
vfSet offset 0.000000 6.000000
vfSet gravity -0.030000 -0.025000
vfSet angle 0.000000 360.000000
vfSet spin 0.000000 360.000000
vfSet bone ""
vfSet alt_offset 0.000000 0.000000
vfSet max_range 0.000000
vfSet minZ -999999.000000
vfSet maxZ 999999.000000

