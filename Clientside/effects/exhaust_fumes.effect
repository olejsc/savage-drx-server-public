//Particles:
vfEdit 0
vfSet visclass "particles"
vfSet flags -parent_pos -parent_vel -param_location -param_scale -param_count 
vfSet shader "/textures/effects/explosions/green/1_nl_exp_green.tga"
vfSet size 2.000000 4.000000
vfSet growth 20.000000 40.000000
vfSet alpha 0.0000000 0.3000000
vfSet fade -1.000000 -1.000000
vfSet white 0.100000 0.3000000
vfSet whitefade -1.00000 -1.000000
vfSet red 0.5000000 0.500000
vfSet green 0.500000 0.500000
vfSet blue 0.5000000 0.500000
vfSet redfade -1.000000 -1.00000
vfSet greenfade -1.000000 -1.000000
vfSet bluefade -1.000000 -1.000000
vfSet delay 250 250
vfSet lifetime 2000 5000
vfSet tilelength 0.000000
vfSet style "point"
vfSet model ""
vfSet skin ""
vfSet count 1 1
vfSet velocity 1.000000 5.000000
vfSet acceleration 0.000000 0.000000
vfSet fps 30 30
vfSet offset 0.000000 0.000000
vfSet gravity -0.01000 -0.005000
vfSet angle 0.000000 360.000000
vfSet spin -180.000000 180.000000
vfSet bone "Exhaust Tip"
