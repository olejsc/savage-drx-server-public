//Particles:
vfEdit 0
vfSet visclass "particles"
vfSet flags -parent_pos -parent_vel -param_location -param_scale -param_count -param_groundz +param_sinewave +param_nearparent -param_billboard2d 
vfSet shader "textures/weather_effects/snow.tga"
vfSet size 1.000000 1.200000
vfSet sizeHeight 1.000000 1.200000
vfSet growth 0.000000 0.000000
vfSet alpha 1.000000 1.000000
vfSet fade 1.000000 1.000000
vfSet white 1.000000 1.000000
vfSet whitefade 0.000000 0.000000
vfSet red 0.000000 0.000000
vfSet green 0.000000 0.000000
vfSet blue 0.000000 0.000000
vfSet redfade 0.000000 0.000000
vfSet greenfade 0.000000 0.000000
vfSet bluefade 0.000000 0.000000
vfSet delay 0 100
vfSet lifetime 4000 8000
vfSet tilelength 0.000000
vfSet style "point"
vfSet model ""
vfSet skin ""
vfSet count 800 1000
vfSet velocity -4.000000 4.000000
vfSet acceleration 0.000000 0.000000
vfSet fps 15 15
vfSet offset 10.000000 200.000000
vfSet gravity 0.007000 0.015000
vfSet angle 0.000000 360.000000
vfSet spin -0.600000 0.600000
vfSet bone ""
vfSet alt_offset 12.000000 19.000000
vfSet max_range 200.000000
vfSet minZ -100.000000
vfSet maxZ 999999.000000

