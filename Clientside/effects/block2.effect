efSet sound1 "/sound/general/block_1.wav"
efSet sound2 "/sound/general/block_2.wav"
efSet sound3 "/sound/general/block_3.wav"
efSet sound4 ""
efSet loopsound ""
efSet cmdrSound ""
efSet broadcastSound ""
efSet stopLoopSound 1
efSet soundVolume 1
efSet soundRadius 20
efSet cameraShake 10.000000 10.000000

//Particles:
vfEdit 0
vfSet visclass "particles"
vfSet flags -parent_pos -parent_vel -param_location -param_scale -param_count 
vfSet shader "/textures/effects/blockspark1.png"
vfSet size 25.000000 30.000000
vfSet growth 15.000000 20.000000
vfSet alpha 0.900000 1.000000
vfSet fade 0.000000 0.000000
vfSet white 1.000000 1.000000
vfSet whitefade 0.000000 0.000000
vfSet red 1.000000 1.000000
vfSet green 1.000000 1.000000
vfSet blue 1.000000 1.000000
vfSet redfade 0.000000 0.000000
vfSet greenfade 0.000000 0.000000
vfSet bluefade 0.000000 0.000000
vfSet delay 0 0
vfSet lifetime 50 50
vfSet tilelength 0.000000
vfSet style "point"
vfSet model ""
vfSet skin ""
vfSet count 1 1
vfSet velocity 50.000000 100.000000
vfSet acceleration 0.000000 0.000000
vfSet fps 30 30
vfSet offset 0.000000 2.000000
vfSet gravity 0.500000 0.500000
vfSet angle 0.000000 360.000000
vfSet spin 0.000000 0.000000
vfSet bone "bip01 spine1"
vfSet forcedOffsetZ 10.000000

